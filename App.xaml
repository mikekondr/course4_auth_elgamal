<Application x:Class="auth_elgamal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:auth_elgamal"
             xmlns:vm="clr-namespace:auth_elgamal.ViewModels"
             xmlns:v="clr-namespace:auth_elgamal.Views"
             xmlns:converters="clr-namespace:auth_elgamal.Converters"
             xmlns:notifications="clr-namespace:auth_elgamal.Models.Notifications"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToFalseConverter x:Key="NullToFalseConverter"/>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <v:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdminViewModel}">
                <v:AdminView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UserViewModel}">
                <v:UserView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                <v:DriveView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EncryptionViewModel}">
                <v:EncryptionView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type notifications:SuccessNotification}">
                <Border Background="#CC2E7D32"
                    CornerRadius="4" MinWidth="288" MaxWidth="568">
                    <StackPanel Orientation="Horizontal" Margin="16,10">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                             Foreground="White" 
                                             VerticalAlignment="Center" 
                                             Margin="0,0,10,0"
                                             Width="20" Height="20"/>
                        <TextBlock Text="{Binding Message}" 
                               Foreground="White" 
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type notifications:ErrorNotification}">
                <Border Background="#CCC62828"
						CornerRadius="4" MinWidth="288" MaxWidth="568">
                    <Grid Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="AlertCircleOutline" 
									 Foreground="White" 
									 VerticalAlignment="Center"
									 Width="20" Height="20"
									 Grid.Column="0"/>

                        <TextBlock Text="{Binding Message}" 
					               Foreground="White" 
					               FontWeight="Bold"
					               VerticalAlignment="Center"
					               TextWrapping="Wrap"
					               Margin="12,0"
					               Grid.Column="1"/>

                        <Button Content="OK"
					            Style="{DynamicResource MaterialDesignFlatButton}"
					            Foreground="White"
					            Grid.Column="2"
					            VerticalAlignment="Center"
					            Command="{Binding RelativeSource={RelativeSource AncestorType=materialDesign:SnackbarMessage}, Path=CloseCommand}"/>
                    </Grid>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
